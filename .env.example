# Local Ollama Configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=512

# Vector Store and Storage Paths
RAG_DATA_DIR=data
RAG_INDEX_PATH=vector.index
RAG_METADATA_PATH=chunks_metadata.json
FRONTEND_DIST=frontend/dist

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

